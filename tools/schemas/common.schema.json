{
  "$id": "common",
  "$defs": {
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "season": { "type": "integer", "minimum": 1, "maximum": 8 },
    "text": { "type": "string", "minLength": 1 },
    "paragraphs": { "type": "array", "items": { "$ref": "#/$defs/text" } },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["label", "url"],
        "additionalProperties": false,
        "properties": { "label": { "$ref": "#/$defs/text" }, "url": { "type": "string", "pattern": "^https://" } }
      }
    },
    "seasonText": {
      "type": "object",
      "required": ["text"],
      "additionalProperties": false,
      "properties": { "text": { "$ref": "#/$defs/text" }, "s": { "$ref": "#/$defs/season" } }
    },
    "seasonParagraphs": {
      "type": "object",
      "required": ["paragraphs"],
      "additionalProperties": false,
      "properties": {
        "s": { "$ref": "#/$defs/season" },
        "title": { "type": "string" },
        "paragraphs": { "$ref": "#/$defs/paragraphs" }
      }
    },
    "image": { "type": ["string", "null"], "pattern": "^images/.+\\.(webp|svg)$" },
    "doute": { "type": "string" }
  }
}
