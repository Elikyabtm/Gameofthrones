{
  "$id": "place",
  "type": "object",
  "required": [
    "slug",
    "name",
    "kind",
    "region",
    "continent",
    "description",
    "history",
    "events",
    "sources"
  ],
  "additionalProperties": false,
  "properties": {
    "slug": { "$ref": "common#/$defs/slug" },
    "name": { "$ref": "common#/$defs/text" },
    "kind": {
      "enum": ["château", "cité", "région", "ruine", "mer", "île", "forteresse", "temple"]
    },
    "region": { "$ref": "common#/$defs/text" },
    "continent": { "enum": ["westeros", "essos"] },
    "coords": {
      "type": "object",
      "required": ["x", "y"],
      "additionalProperties": false,
      "properties": { "x": { "type": "number" }, "y": { "type": "number" } }
    },
    "summary": { "type": "string" },
    "rulers": { "type": "array", "items": { "$ref": "common#/$defs/seasonText" } },
    "house": { "$ref": "common#/$defs/slug" },
    "description": { "$ref": "common#/$defs/paragraphs" },
    "history": { "$ref": "common#/$defs/paragraphs" },
    "events": { "type": "array", "items": { "$ref": "common#/$defs/seasonText" } },
    "image": { "$ref": "common#/$defs/image" },
    "sources": { "$ref": "common#/$defs/sources" },
    "_doute": { "$ref": "common#/$defs/doute" }
  }
}
